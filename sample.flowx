// All inputs from a file are errorable. Recover them before plain arithmetic.
struct Pair {
    whole: int4, fraction: float4
}

fn combine(left: int4, right: int4) -> (result: int4) {
    (left, right) -> add as result;
}

fn main(rawInt: int4!, rawFloat: float4!, maybeInt: int4?!, maybeFloat: float4?!)
    -> (whole: int4, fraction: float4, logic: bool, recoveredInt: int4, recoveredFloat: float4) {
    // Error recovery, then null recovery: ?! -> ? -> plain.
    (rawInt, 10) -> errorToValue as x;
    (rawFloat, 1.5) -> errorToValue as y;
    (maybeInt, 20) -> errorToValue as optionalInt;
    (maybeFloat, 2.5) -> errorToValue as optionalFloat;
    (optionalInt, 30) -> nullToValue as filledInt;
    (optionalFloat, 3.5) -> nullToValue as filledFloat;

    // Null recovery first: ?! -> !, then error recovery.
    (maybeInt, 40) -> nullToValue as checkedInt;
    (maybeFloat, 4.5) -> nullToValue as checkedFloat;
    (checkedInt, 50) -> errorToValue as recoveredInt;
    (checkedFloat, 5.5) -> errorToValue as recoveredFloat;

    // Arithmetic on both supported types.
    (x, 2) -> combine as addedInt;
    (addedInt, 1) -> subtract as subtractedInt;
    (subtractedInt, 3) -> multiply as intResult;
    (y, 2.0) -> add as addedFloat;
    (addedFloat, 1.0) -> subtract as subtractedFloat;
    (subtractedFloat, 3.0) -> multiply as floatResult;

    // Boolean operators and comparisons; false < true.
    (true, false) -> and as both;
    (both, true) -> or -> not as inverted;
    (false, true) -> less as smaller;
    (true, true) -> lessEqual as atMost;
    (smaller, atMost) -> equal as same;
    (inverted, same) -> or as logic;

    // Successful assertions can be unwrapped by panic.
    (intResult, true) -> assert -> panic as safeInt;
    (floatResult, true) -> assert -> panic as safeFloat;
    (safeInt, safeFloat) -> Pair as pair;
    pair.whole as whole;
    pair.fraction as fraction;

    // Failed assertions are recovered rather than terminating this example.
    ((filledInt, false) -> assert, 100) -> errorToValue;
    ((filledFloat, false) -> assert, 100.0) -> errorToValue;

    // Also exercise nullable panic overloads. Error input terminates the program.
    maybeInt -> panic;
    maybeFloat -> panic;

    // Uncomment to deliberately trigger panic at runtime:
    // (1, false) -> assert -> panic;
}
